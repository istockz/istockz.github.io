,63539],["2026-11-06",55.7,58.2,55.7,57.83,7029]],"fundamentals":{"long_name":"Denis Chem Lab Limited","website":"https://denischemlab.com","city":"Ahmedabad","trailing_pe":9.587579,"eps_trailing":6.28,"dividend_rate":1.5,"dividend_yield":2.49,"payout_ratio":0.23889999,"ebitda_margins":0.0,"gross_margins":0.0,"operating_margins":0.0,"profit_margins":0.0,"shares_outstanding":13876668.0,"held_pct_insiders":0.78400004,"held_pct_institutions":0.0,"fifty_two_week_high":114.85,"fifty_two_week_low":59.22,"fifty_day_average":75.8796,"two_hundred_day_avg":88.8412,"recommendation":"none","all_time_high":180.0,"all_time_low":66.31,"long_business_summary":"Denis Chem Lab Limited, a pharmaceutical company, engages in the manufacturing and marketing of sterile intravenous injectable products for human and veterinary use in India. The company's products include antibiotic injections, diuretic injections, parenteral amino acid injections, plasma volume expanders, anti-anaerobic injections, anti-pyretic injections, irrigation and dialysis solutions, etc. It also provides contract manufacturing services for third parties, as well as manufactures and sells transfusion solutions in bottles. The company serves government and semi-government institutions, hospitals and nursing homes, aided agencies, and defense sector. It also exports its products to Sri Lanka, Vietnam, Cambodia, Somalia, Nepal, Ivory Coast, etc. The company was incorporated in 1980 and is based in Ahmedabad, India."}}