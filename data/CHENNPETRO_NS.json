,["2026-08-27",1375.0,1390.0,1350.0,1352.4,579400],["2026-08-28",1359.1,1376.0,1333.2,1341.1,690557],["2026-08-31",1347.0,1380.0,1325.1,1367.4,1136841],["2026-09-01",1380.0,1424.4,1364.2,1387.0,2212980],["2026-09-02",1396.6,1423.5,1382.5,1414.0,1672729]],"fundamentals":{"long_name":"Chennai Petroleum Corporation Limited","website":"https://www.cpcl.co.in","city":"Chennai","full_time_employees":1413,"trailing_pe":6.6446276,"price_to_book":1.6191262,"book_value":592.758,"eps_trailing":144.44,"dividend_rate":13.0,"dividend_yield":1.35,"payout_ratio":0.0346,"five_yr_avg_div_yield":6.05,"revenue":640718471168.0,"revenue_per_share":4302.804,"revenue_growth":0.213,"ebitda":35761025024.0,"ebitda_margins":0.055809997,"gross_margins":0.08344,"operating_margins":0.08420999,"profit_margins":0.033570003,"net_income":21507700736.0,"total_cash":1993699968.0,"total_cash_per_share":13.388,"total_debt":19331600384.0,"debt_to_equity":21.902,"enterprise_value":160257310720.0,"enterprise_to_ebitda":4.481,"enterprise_to_revenue":0.25,"earnings_growth":47.043,"shares_outstanding":148911400.0,"float_shares":44915191.0,"held_pct_insiders":0.67794997,"held_pct_institutions":0.052160002,"beta":0.14,"fifty_two_week_high":1103.0,"fifty_two_week_low":527.0,"fifty_day_average":906.8,"two_hundred_day_avg":819.736,"recommendation":"none","all_time_high":1275.0,"all_time_low":24.7,"long_business_summary":"Chennai Petroleum Corporation Limited produces and supplies petroleum products in India. The company offers liquefied petroleum gas, naphtha, motor gasoline and spirit, kerosene, aviation turbine fuel, automotive high-speed and high flash diesel, light diesel oil, and bunker and non-bunker fuel oil. It also provides lube products, such as paving bitumen, lube oil base stocks, and extracts. In addition, the company offers paraffin wax, mineral turpentine oil, food grade and pharma grade hexane, petrochemical feedstocks, micro crystalline wax, sulphur, pet-coke, propylene, poly butene feedstock (PBFS), methyl ethyl ketone feedstock, and kerosene supply. Further, it provides asphalt, linear alkyl benzene feedstock, butene-2, lean butene, lean PBFS, furnace oil, isrosene, ISRO naphtha, propylene glycol and polyols, poly iso-butylene, NATO diesel, JP-5 fuel for fighter jets, and missile fuels. The company was formerly known as Madras Refineries Limited and changed its name to Chennai Petroleum Corporation Limited in June 2000. The company was incorporated in 1965 and is based in Chennai, India. Chennai Petroleum Corporation Limited is a subsidiary of Indian Oil Corporation Limited."}}