.0,392.0,377.15,381.5,11959002],["2026-09-01",383.0,383.75,368.6,372.0,6155527],["2026-09-02",371.65,373.5,367.5,370.0,4445955]],"fundamentals":{"long_name":"National Aluminium Company Limited","website":"https://nalcoindia.com","city":"Bhubaneswar","full_time_employees":4803,"trailing_pe":11.097816,"forward_pe":11.771305,"price_to_book":3.4331505,"book_value":108.064,"eps_trailing":33.43,"eps_forward":31.51732,"dividend_rate":15.0,"dividend_yield":4.04,"payout_ratio":0.314,"five_yr_avg_div_yield":4.46,"revenue":180980596736.0,"revenue_per_share":98.544,"revenue_growth":0.015,"ebitda":82850201600.0,"ebitda_margins":0.45778,"gross_margins":0.70835996,"operating_margins":0.42151,"profit_margins":0.33936,"net_income":61418000384.0,"total_cash":79060402176.0,"total_cash_per_share":43.07,"total_debt":558800000.0,"debt_to_equity":0.282,"enterprise_value":602511835136.0,"enterprise_to_ebitda":7.272,"enterprise_to_revenue":3.329,"earnings_growth":0.019,"shares_outstanding":1836631787.0,"float_shares":893742904.0,"held_pct_insiders":0.51278,"held_pct_institutions":0.21131,"beta":0.875,"fifty_two_week_high":431.5,"fifty_two_week_low":137.75,"fifty_day_average":370.201,"two_hundred_day_avg":263.9367,"target_high_price":425.0,"target_low_price":277.0,"target_mean_price":353.45456,"recommendation":"buy","num_analyst_opinions":11,"all_time_high":431.5,"all_time_low":6.0,"long_business_summary":"National Aluminium Company Limited engages in the manufacture and sale of alumina and aluminum products in India and internationally. The company operates through Chemical and Aluminum segments. It offers aluminum metal products, such as ingots, alloy ingots, T-ingots, sows, billets, and wire rods; alumina and hydrate products, including calcined alumina and alumina hydrate; zeolite-A products; specialty alumina and hydrate products; and aluminum rolled and aluminum chequered sheets products. The company also owns and operates Coal Mine covering an area of 824.316 hectors situated in Chhendipada Tehsil of Angul District; an opencast mine covering an area of 16 square kilometers on Panchpatmali hills of Koraput district in Odisha; a wind power plant with 50.4 MW of generation capacity in Gandikota, Andhra Pradesh; a wind power plant with 47.6 MW of generation capacity at Jaisalmer, Rajasthan; a wind power plant with 50 MW of generation capacity at Devikot, Rajasthan; a wind power plant with 50.4 MW of generation capacity at Sangli, Maharashtra; and a solar power plant in Bhubaneswar, as well as alumina refinery and aluminum smelter plants and captive power plant. In addition, it owns and operates mechanized storage and ship handling facilities for exporting alumina and importing caustic soda. National Aluminium Company Limited was incorporated in 1981 and is based in Bhubaneswar, India."}}